{
  "name": "@extantape/payload-plugin-sharing",
  "version": "0.1.0",
  "private": true,
  "description": "Sharing for Payload: people share records with other users and organizations, under access rules the host passes in.",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "sharing",
    "permissions",
    "access-control",
    "collaboration",
    "organizations"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ExtantApe/payload-plugin-sharing#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/payload-plugin-sharing/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/payload-plugin-sharing.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.80.0"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/graphql": "3.92.1",
    "@types/node": "^24.0.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "payload": "3.92.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
